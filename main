#!/bin/bash
TERM=xterm-256color
COLUMNS=238
prependWidth=26
tail=5

# Formatting
reset=`echo -e '\033[0m'`
black=`echo -e '\033[0;30m'`
red=`echo -e '\033[1;31m'`
green=`echo -e '\033[1;32m'`
yellow=`echo -e '\033[1;33m'`
blue=`echo -e '\033[1;34m'`
purple=`echo -e '\033[1;35m'`
cyan=`echo -e '\033[1;36m'`
gray=`echo -e '\033[0;37m'`

function prepend_output () {
    outputtingService=$1
    sed -e "s/^/${outputtingService} /"
}

function populate_namespaces_array () {
    x=1
    for line in $namespaces ;
    do
        namespacesArray[x]=$line
        x=$((x+1))
    done
}

function populate_services_array () {
    x=1
    for line in $(kubectl get deploy -o name --no-headers -n $chosenNamespace );
    do
        local serviceName=$(sed 's/deployment.extensions\//remote-/' <<< "$line")
        servicesArray[x]="$serviceName"
        x=$((x+1))
    done
}

function kill_existing_port_forwarding () {
    echo -e "${red}Killing any existing port-forwarding processes...${reset}"
    echo ""
    $(killall kubectl port-forward &> /dev/null)
}

function monitoring_service () {
    while [ true ]; do
        for service in ${servicesArray[@]} ;
        do
            serviceConnection $service
        done
    done
}

function serviceConnection () {
    local serviceName=$1

    local portFwdSvcProcessNameVarName="${service}PortFwdSvcProcessName"
    local servicePortFwdPIDVarName="${serviceName}ServicePortForwardPID"
    local servicePortVarName="${serviceName}ServicePort"

    local portFwdSvcProcessName="${!portFwdSvcProcessNameVarName}"
    local servicePortForwardPID="${!servicePortFwdPIDVarName}"
    local servicePort="${!servicePortVarName}"

    if [[ ( -z "$servicePortForwardPID" ) || ( ! -z "$servicePortForwardPID" &&  ! $(ps -o pid= -p $servicePortForwardPID)  ) ]]
    then
        kubectl port-forward svc/${serviceName} $servicePort:80 -n $chosenNamespace | prepend_output $portFwdSvcProcessName &
        ${serviceName}ServicePortForwardPID=$!
    fi
}

function open_in_chrome () {
    local hostRules=""
    local servicePortVarName=""
    for service in ${servicesArray[@]} ;
    do
        [[ -n $hostRules ]] && hostRules="${hostRules},"
        servicePortVarName="${service}ServicePort"
        hostRules="${hostRules}MAP $service 127.0.0.1:${!servicePortVarName}"
    done

    mkdir "First Run"

    /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
      --host-rules="${hostRules}" \
      --user-data-dir="./First Run" \
      --no-first-run \
      --disable-web-security \
      --allow-file-access-from-files \
      --allow-file-access http://localhost:3010 | prepend_output $chromeProcessName &
}

function cycle_through_services () {
    echo "Initiating trailing logs for all backend services in $chosenNamespace environment..." | prepend_output $systemProcessName
    for service in ${servicesArray[@]} ;
    do
        stream_remote_log $service &
    done
}

function stream_remote_log () {
    local serviceName=$1
    local serviceName=$(tr '[:lower:]' '[:upper:]' <<< "$serviceName")
    # Pads out serviceName variable with "-" to make uniform length service names in logging output
    local serviceName=$(awk '{x=$0;for(i=length;i<24;i++)x=x "-";}END{print x}' <<< "$serviceName")
    local serviceName="$serviceName$reset"
    local serviceName=$(sed -e "s/^/${purple}/" <<< "$serviceName")
    kubectl logs $1 -n $chosenNamespace --tail=$tail -f | less -S +F | prepend_output $serviceName &
}

function start () {
    clear

    kill_existing_port_forwarding | prepend_output $systemProcessName
    echo ""
    echo ""
    echo "Initiating port-forwarding service..." | prepend_output $systemProcessName
    echo ""
    echo ""
    echo "------------------------------------------USE CTRL-C TO EXIT------------------------------------------"
    echo "                       Running server against '''$chosenNamespace''' namespace"
    echo "------------------------------------------------------------------------------------------------------"
    echo ""
    echo "                           AUTO-START FRONTEND = $autostart                                           "
    echo "                                    K8 LOGGING = $logging                                             "
    echo ""
    echo "                                      NODE_ENV = $NODE_ENV                                            "
    echo ""
    echo ""
    echo ""
    echo "                              Frontend will open in chrome automatically                              "
    echo ""
    echo ""
    echo "                        Backend services are available at http://localhost on the                     "
    echo "                           following ports for the corresponding service                              "
    for service in ${servicesArray[@]} ;
    do
        echo "                              $service - http://${service}"
    done
    echo ""
    echo "------------------------------------------------------------------------------------------------------"
    echo ""

    open_in_chrome

    if [ $logging = "true" ]
    then
        cycle_through_services
    fi
    monitoring_service
}

function adjust_settings () {
    clear
    local choice
    read -n 1 -p "Logging is set tail $tail lines. Would you like to pull in ALL logs from deployment of pod? (y/n) " choice
    case $choice in
        [yY] ) tail=9999999 ;;
        [nN] ) tail=$tail ;;
        *) echo "invalid entry" ;;
    esac
    show_menus
}

function bring_it_all_down () {
    clear
    pkill -9 -g $parentPID && echo "ALL CHILD PROCESSES HAVE BEEN TERMINATED. ERASING TEMPORARY FILES..."
    rm -rf "./First Run"
    exit 0
}

function show_menus () {
	  clear
    echo "--------------------------------------"
	  echo "         N A M E S P A C E S"
	  echo "--------------------------------------"
	  i=1
    for namespace in ${namespacesArray[@]} ;
    do
        echo $i - $namespace
        i=$((i+1))
    done
    echo ""
    echo "s - SETTINGS"
    echo "q - EXIT"
    echo ""
    echo ""
    read_options
}

function read_options () {
	  local choice
	  read -n 1 -p "Select namespace to run against " choice
    chosenNamespace="${namespacesArray[$choice]}"
	  case $choice in
        $option) populate_services_array ;;
        s) adjust_settings ;;
	  	  q) bring_it_all_down ;;
	  	  *) echo -e "${RED}Select a number from the list or press 'q' to exit${STD}" && sleep 2
	  esac
}

# GLOBALS
parentPID=$(ps -p $$ -o pgid=)
logging="true"
frontend="true"

# Exit procedure
trap 'bring_it_all_down' SIGHUP SIGINT SIGQUIT SIGTERM SIGABRT

# Check command line args
while getopts sqh option
do
    case "${option}" in
        s) frontend="false";;
        q) logging="false";;
        h)  echo "-s disables frontend"
            echo "-q disables K8 logging"
            exit
    esac
done

# Logging service names
systemProcessName="${yellow}SYSETM------------------"
chromeProcessName="${red}CHROME------------------${reset}"

# Namespace array
namespaces=$(kubectl get ns | awk '{print $1}')
namespacesArray=()
populate_namespaces_array
len=${#namespacesArray[@]}
option=[1-$len]

# Services array
servicesArray=()

# Begin
show_menus

x=1
for service in ${servicesArray[@]} ;
do
    # Process ID variable declarations
    export ${service}ServicePortForwardPID=

    # Logging service names
    export ${service}PortFwdSvcProcessName="${green}PORTFWD-${service^^}-SVC--------${reset}"

    # Service port declarations
    export ${service}ServicePort="600${x}"

    x=$((x+1))
done
unset x

start
